page {
  background-color: #f5f7fa;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

.feed-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

/* 顶部状态卡片 */
.header-card {
  background: linear-gradient(135deg, #156082 0%, #1d769e 100%);
  border-radius: 24rpx;
  padding: 28rpx;
  color: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(21, 96, 130, 0.18);
  margin-bottom: 24rpx;
}

.brand-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.brand-info {
  display: flex;
  flex-direction: column;
}

.brand-title {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #ffffff;
}

.brand-subtitle {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.84);
  margin-top: 6rpx;
}

.count-pill {
  background-color: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 500;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}

.user-bar,
.guest-bar {
  background-color: rgba(255, 255, 255, 0.96);
  color: #1f2937;
  border-radius: 18rpx;
  padding: 22rpx;
}

.user-identity {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.avatar-self {
  background-color: #156082;
  color: #ffffff;
}

.avatar-post {
  background-color: #e6f2f7;
  color: #156082;
}

.user-meta {
  margin-left: 18rpx;
  flex: 1;
  min-width: 0;
}

.user-name-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  max-width: 340rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-badge {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #0f6b4b;
  background-color: #e6f7f0;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

.user-hint {
  display: block;
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 6rpx;
}

.header-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  margin: 0;
  width: auto;
  min-height: 0;
  padding: 0 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 14rpx;
  text-align: center;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn::after,
.refresh-btn::after,
.retry-btn::after {
  border: none;
}

.header-actions .action-btn {
  flex: 1;
}

.action-btn-primary {
  background-color: #156082;
  color: #ffffff;
}

.action-btn-primary:active {
  background-color: #0f4c68;
}

.action-btn-secondary {
  background-color: #edf2f7;
  color: #334155;
}

.action-btn-secondary:active {
  background-color: #e2e8f0;
}

.guest-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.guest-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.guest-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.guest-desc {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 6rpx;
  line-height: 1.5;
}

.guest-login-btn {
  flex-shrink: 0;
  min-width: 156rpx;
}

/* 列表工具栏 */
.toolbar-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 8rpx 4rpx 20rpx;
}

.toolbar-left {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.update-hint {
  font-size: 22rpx;
  color: #6b7280;
}

.refresh-btn {
  margin: 0;
  width: auto;
  min-height: 0;
  background-color: #ffffff;
  color: #156082;
  border: 2rpx solid #cfe2ec;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
  padding: 0 24rpx;
  height: 58rpx;
  line-height: 54rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.refresh-btn:active {
  background-color: #eef6fa;
}

/* 错误提示条 */
.error-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background-color: #fef2f2;
  border: 2rpx solid #fecaca;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.error-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.error-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #b91c1c;
}

.error-text {
  font-size: 23rpx;
  color: #991b1b;
  margin-top: 4rpx;
  line-height: 1.45;
}

.retry-btn {
  margin: 0;
  width: auto;
  min-height: 0;
  flex-shrink: 0;
  background-color: #dc2626;
  color: #ffffff;
  font-size: 24rpx;
  border-radius: 12rpx;
  height: 58rpx;
  line-height: 58rpx;
  padding: 0 24rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* 加载态与空态 */
.state-card {
  background-color: #ffffff;
  border-radius: 22rpx;
  padding: 64rpx 36rpx;
  text-align: center;
  box-shadow: 0 4rpx 18rpx rgba(15, 23, 42, 0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background-color: #e6f2f7;
  color: #156082;
  font-size: 42rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.state-title {
  font-size: 29rpx;
  font-weight: 600;
  color: #1f2937;
  line-height: 1.5;
}

.state-desc {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 10rpx;
  line-height: 1.5;
}

.empty-cta {
  margin-top: 28rpx;
  min-width: 240rpx;
}

/* 校园动态卡片 */
.post-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.post-card {
  background-color: #ffffff;
  border-radius: 22rpx;
  padding: 26rpx 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid #edf1f5;
}

.post-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.post-author-wrap {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.post-author-meta {
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.post-author-name {
  font-size: 29rpx;
  font-weight: 600;
  color: #111827;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-time {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 4rpx;
}

.post-id-tag {
  font-size: 22rpx;
  color: #94a3b8;
  font-weight: 500;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.post-body {
  padding: 4rpx 0 18rpx;
}

.post-text {
  display: block;
  font-size: 30rpx;
  line-height: 1.7;
  color: #1f2937;
  white-space: pre-wrap;
  word-break: break-word;
}

.post-footer {
  border-top: 1rpx solid #f1f5f9;
  padding-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.post-type-tag {
  font-size: 21rpx;
  color: #156082;
  background-color: #eef6fa;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.list-end-tip {
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
  padding: 12rpx 0 8rpx;
}
