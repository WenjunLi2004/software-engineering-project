.login-page {
  min-height: 100vh;
  padding: 48rpx 32rpx 64rpx;
  box-sizing: border-box;
  background-color: #f5f7fa;
  display: flex;
  flex-direction: column;
}

.hero {
  margin-bottom: 32rpx;
  padding: 8rpx 8rpx 0;
}

.hero-badge {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background-color: #e4f1f7;
  color: #156082;
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 18rpx;
}

.hero-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #162433;
  line-height: 1.3;
}

.hero-subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #5c6b7a;
  line-height: 1.5;
}

.session-banner {
  background-color: #ebf4f8;
  border: 2rpx solid #c4dfec;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.session-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.session-label {
  font-size: 24rpx;
  color: #4b6273;
  flex-shrink: 0;
}

.session-username {
  font-size: 26rpx;
  font-weight: 600;
  color: #156082;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.session-link {
  font-size: 24rpx;
  color: #156082;
  font-weight: 500;
}

.session-logout {
  color: #c93b3b;
}

.session-divider {
  font-size: 22rpx;
  color: #a8becb;
}

.auth-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx 40rpx;
  box-shadow: 0 8rpx 28rpx rgba(21, 96, 130, 0.08);
}

.mode-tabs {
  display: flex;
  background-color: #eef3f7;
  border-radius: 14rpx;
  padding: 8rpx;
  margin-bottom: 32rpx;
}

.mode-tab {
  flex: 1;
  text-align: center;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 10rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #5c6b7a;
}

.mode-tab-active {
  background-color: #ffffff;
  color: #156082;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(21, 96, 130, 0.12);
}

.error-banner {
  background-color: #fff2f0;
  border: 2rpx solid #ffccc7;
  border-radius: 12rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 24rpx;
}

.error-text {
  font-size: 26rpx;
  color: #cf1322;
  line-height: 1.45;
}

.form-group {
  margin-bottom: 28rpx;
}

.field-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #2c3a47;
  margin-bottom: 12rpx;
}

.field-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  background-color: #f7f9fb;
  border: 2rpx solid #dce4ec;
  font-size: 30rpx;
  color: #162433;
}

.field-placeholder {
  color: #9aa7b4;
}

.submit-btn {
  margin-top: 12rpx;
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 14rpx;
  background-color: #156082;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  padding: 0;
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  background-color: #7ca7bb;
  color: #ffffff;
}

.switch-hint {
  margin-top: 28rpx;
  text-align: center;
  font-size: 26rpx;
}

.switch-hint-text {
  color: #6b7a88;
}

.switch-hint-link {
  color: #156082;
  font-weight: 600;
  margin-left: 8rpx;
}

.guest-section {
  margin-top: 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.guest-btn {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 14rpx;
  background-color: #ffffff;
  color: #156082;
  border: 2rpx solid #c4dfec;
  font-size: 28rpx;
  font-weight: 500;
  padding: 0;
}

.guest-btn::after {
  border: none;
}

.guest-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #7a8896;
  text-align: center;
}
